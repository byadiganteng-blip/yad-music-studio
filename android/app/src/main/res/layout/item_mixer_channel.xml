<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="#1E293B"
    android:layout_marginEnd="4dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvMixerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kick"
        android:textColor="#60A5FA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VOL"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/seekVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvVolumeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80%"
        android:textColor="#CBD5E1"
        android:textSize="10sp"
        android:fontFamily="monospace" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PAN"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginTop="4dp" />

    <SeekBar
        android:id="@+id/seekPan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="🔊"
            android:textSize="10sp"
            android:backgroundTint="#3B82F6"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnSolo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="S"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FX"
        android:textColor="#94A3B8"
        android:textSize="9sp"
        android:layout_marginTop="4dp" />

    <CheckBox
        android:id="@+id/cbReverb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reverb"
        android:textColor="#CBD5E1"
        android:textSize="10sp" />

    <CheckBox
        android:id="@+id/cbDelay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delay"
        android:textColor="#CBD5E1"
        android:textSize="10sp" />

    <CheckBox
        android:id="@+id/cbDistortion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distort"
        android:textColor="#CBD5E1"
        android:textSize="10sp" />

</LinearLayout>
